{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/relay.mjs",
        "timeout": 540,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "node .cursor/hooks/relay.mjs",
        "timeout": 540,
        "failClosed": true,
        "matcher": "Write|StrReplace|Delete|Edit"
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "node .cursor/hooks/relay.mjs",
        "timeout": 540,
        "failClosed": true
      }
    ]
  }
}
